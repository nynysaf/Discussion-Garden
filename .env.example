# Discussion Garden — environment template
# Copy to `.env.local` for local development:
#   copy .env.example .env.local
# PLACEHOLDERS ONLY in this file. This repo is public — never paste real keys here.
# Add the same names in Vercel → Project → Settings → Environment Variables.

# Deepgram (server only — never NEXT_PUBLIC_)
# Console → API Keys → Create Key → Advanced → Member permission
DEEPGRAM_API_KEY=

# Supabase — local dev: run `npm run db:start`, then copy the values it prints
# (API URL, Publishable key, Secret key). Hosted: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase *publishable* key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase secret key (server only — used by scripts/add-host.mjs)
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_SYNTHESIS_MODEL=

# Hosts are managed in the database (public.hosts), not here:
#   npm run host:add -- someone@example.com "a long password"
